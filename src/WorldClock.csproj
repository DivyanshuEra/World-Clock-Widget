<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>WorldClock.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    
    <!-- Production & Open-Source Metadata -->
    <AssemblyTitle>World Clock</AssemblyTitle>
    <Product>World Clock Widget</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Divyanshu Era</Authors>
    <Company>Open Source</Company>
    <Description>Lightweight, Movable Floating World Clock Widget for Windows</Description>
    <Copyright>Copyright © 2026 Divyanshu Era. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/DivyanshuEra/World-Clock-Widget</RepositoryUrl>

    <!-- Portable Single-File Deployment Settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
