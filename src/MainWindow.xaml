<Window x:Class="WorldClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Clock"
        Width="340"
        Height="480"
        MinWidth="260"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#14151b"
        Topmost="True"
        ShowInTaskbar="True"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6,0,6,6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 1. Header Button Style (Pin, Minimize, Close) with subtle dark hover -->
        <Style x:Key="SubtleHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252836"/>
                                <Setter Property="Foreground" Value="#f1f5f9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#171922"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Footer "+ Add Country" Button Style (Soft, Dimmed Hover - No Text Washout!) -->
        <Style x:Key="AddCountryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1f2330"/>
            <Setter Property="BorderBrush" Value="#2e3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Dimmed gentle dark tint, crystal clear text -->
                                <Setter TargetName="bd" Property="Background" Value="#283042"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="#7dd3fc"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#161822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Save Button Style (Dimmed Ocean Blue Hover) -->
        <Style x:Key="ActionSaveBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0369a1"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284c7"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Cancel Button Style (Subtle Charcoal Hover) -->
        <Style x:Key="ActionCancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222b"/>
            <Setter Property="BorderBrush" Value="#2f313e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2b2f3d"/>
                                <Setter Property="Foreground" Value="#f1f5f9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#17181f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. Delete Button Style (Subtle Crimson Hover) -->
        <Style x:Key="ActionDeleteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2d171c"/>
            <Setter Property="BorderBrush" Value="#4e2129"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3d1d24"/>
                                <Setter Property="Foreground" Value="#fca5a5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1f1013"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Solid Border -->
    <Border Background="#14151b" 
            BorderBrush="#2e313e" 
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar: ONLY THIS BAR IS DRAGGABLE FOR THE WHOLE WINDOW -->
            <Border x:Name="HeaderBar" 
                    Grid.Row="0" 
                    Background="#1c1e26" 
                    BorderBrush="#2a2c38" 
                    BorderThickness="0,0,0,1" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIcon" Text="🌍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitle" Text="World Clock" FontSize="13" FontWeight="SemiBold" Foreground="#f1f5f9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Controls: Pin, Minimize, Close -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Topmost Pin Toggle -->
                        <Button x:Name="PinButton" 
                                Content="📌" 
                                Click="PinButton_Click"
                                Style="{StaticResource SubtleHeaderBtn}"
                                Foreground="#38bdf8" 
                                ToolTip="Pin on Top"/>

                        <!-- Minimize Button (Two Inward Arrows pointing to center) -->
                        <Button x:Name="MinimizeButton" 
                                Click="MinimizeButton_Click"
                                Style="{StaticResource SubtleHeaderBtn}"
                                ToolTip="Minimize">
                            <Path Data="M 11,1 L 7,5 M 11,5 L 7,5 L 7,1 M 1,11 L 5,7 M 1,7 L 5,7 L 5,11" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.4" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" 
                                  StrokeLineJoin="Round"
                                  Width="12" Height="12"/>
                        </Button>

                        <!-- Close Button -->
                        <Button Content="✕" 
                                Click="CloseButton_Click"
                                Style="{StaticResource SubtleHeaderBtn}"
                                FontWeight="Bold" 
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Body: Switchable between Cards List and In-Place Edit/Add Form -->
            <Grid Grid.Row="1">
                <!-- VIEW A: Cards List -->
                <ScrollViewer x:Name="CardsScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,4,0,4">
                    <ItemsControl x:Name="CardsItemsControl" Margin="10,2,10,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Clean Card: Press & Drag to move up/down, Double-Click to Edit -->
                                <Border Margin="0,3" 
                                        Padding="10,8" 
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="#20222b"
                                        BorderBrush="#2e313d"
                                        MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                        MouseMove="Card_MouseMove"
                                        MouseLeftButtonUp="Card_MouseLeftButtonUp">

                                    <Grid>
                                        <!-- Left Side: Country & City (Flag removed) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Country}" FontWeight="SemiBold" FontSize="12" Foreground="#f8fafc"/>
                                            <TextBlock Text="{Binding City}" FontSize="10" Foreground="#94a3b8" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Right Side: Time and Date + UTC offset -->
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CurrentDate}" FontSize="10" Foreground="#64748b" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- VIEW B: In-Place Edit/Add Form (Rendered inside the exact same screen, NO NEW WINDOW) -->
                <Grid x:Name="FormViewContainer" Visibility="Collapsed" Margin="14,10,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header Banner -->
                    <Border Grid.Row="0" Background="#1c1f2b" CornerRadius="8" Padding="10,6" Margin="0,0,0,10" BorderBrush="#2d3345" BorderThickness="1">
                        <TextBlock x:Name="FormModeTitle" Text="Edit Country" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <TextBlock Text="Country Name (or City):" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCountry" TextChanged="TxtCountry_TextChanged" Background="#20222b" Foreground="#f8fafc" BorderBrush="#2e313d" Padding="8,4" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Text="City Name:" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCity" TextChanged="TxtCity_TextChanged" Background="#20222b" Foreground="#f8fafc" BorderBrush="#2e313d" Padding="8,4" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Text="TimeZone or Offset (+5:30, -4, GMT):" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTz" Background="#20222b" Foreground="#f8fafc" BorderBrush="#2e313d" Padding="8,4" FontSize="12" Margin="0,0,0,8"/>

                        <TextBlock Text="Timezone Code (IST, EDT, etc.):" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCode" Background="#20222b" Foreground="#f8fafc" BorderBrush="#2e313d" Padding="8,4" FontSize="12" Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- Form Buttons (With Dimmed Subtle Hovers - Crisp Readable Text!) -->
                    <Border Grid.Row="2" Padding="0,8,0,0">
                        <Grid>
                            <Button x:Name="BtnDelete" Content="🗑 Delete" Click="BtnDelete_Click" Style="{StaticResource ActionDeleteBtnStyle}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource ActionCancelBtnStyle}" Margin="0,0,8,0"/>
                                <Button x:Name="BtnSave" Content="✓ Save" Click="BtnSave_Click" Style="{StaticResource ActionSaveBtnStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Footer Bar with "+" Add Button -->
            <Border x:Name="FooterBar" Grid.Row="2" Background="#181921" BorderBrush="#252733" BorderThickness="0,1,0,0" Padding="10,6">
                <Button x:Name="AddButton" 
                        Click="AddButton_Click"
                        Style="{StaticResource AddCountryBtnStyle}"
                        HorizontalAlignment="Center"
                        ToolTip="Add New Country Clock">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="＋" FontWeight="Bold" FontSize="14" Foreground="#38bdf8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Country" FontSize="11" FontWeight="SemiBold" Foreground="#e2e8f0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
